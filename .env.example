# Copy to .env and fill in. Never commit the real .env.

# Port for the Node server (API + built site)
PORT=3001

# Public URL used for canonical links, Open Graph tags and sitemap.xml (build time)
SITE_URL=https://www.roselawnbuilders.com

# First dashboard login — created automatically on first start if no users exist.
# Use a long, unique password (10+ characters). You can remove these after first run.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the SQLite database lives (default: ./data)
# DATA_DIR=./data

# Set to true when running behind a reverse proxy / load balancer (Render, Fly, Nginx...)
# so rate limiting sees the real visitor IP.
# TRUST_PROXY=true

# Optional: POST every new lead as JSON to this URL (Zapier, Make, Slack workflow, etc.)
# LEAD_WEBHOOK_URL=
